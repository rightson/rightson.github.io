---
layout: null
---
[{% for post in site.posts %}{% capture domain %}{% include domain-key.html post=post %}{% endcapture %}{% assign domain_key = domain | strip %}{% assign domain_info = site.data.domains | where: "key", domain_key | first %}{"domain":{{ domain_key | jsonify }},"domain_title":{{ domain_info.title | default: "其他筆記" | jsonify }},"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: '%Y.%m.%d' | jsonify }},"categories":{{ post.categories | jsonify }},"excerpt":{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | truncate: 200 | jsonify }},"content":{{ post.content | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
